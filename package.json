{
  "name": "horse-looker-4000",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A game for horse lovers and utopians alike.",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
